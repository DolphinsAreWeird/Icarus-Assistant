    "asset.chart":            {"screen": "asset",     "shows": "Line chart of the selected asset's price over the chosen period", "terms": ["price_chart", "volatility"], "screen_data": "chart"},
    "asset.change24h":        {"screen": "asset",     "shows": "How much the price moved in the last 24 hours, in percent", "terms": ["change_24h"], "screen_data": "asset"},
    "asset.buy_button":       {"screen": "asset",     "shows": "Button that starts buying this asset", "terms": [], "screen_data": null},
    "buy.amount_input":       {"screen": "buy",       "shows": "Box where the user types how many baht to spend", "terms": ["minimum_buy"], "screen_data": "buy"},
    "buy.fee_line":           {"screen": "buy",       "shows": "The fee for this purchase", "terms": ["fee"], "screen_data": "buy"},
    "buy.review_button":      {"screen": "buy",       "shows": "Button that opens the review screen", "terms": ["order_preview"], "screen_data": null},
    "buy.confirm_button":     {"screen": "buy_review","shows": "Button that confirms the purchase. Only the user taps it", "terms": ["order_preview"], "screen_data": "buy"},
    "portfolio.chart":        {"screen": "portfolio", "shows": "Line chart of the portfolio's value over the chosen period", "terms": ["portfolio", "price_chart"], "screen_data": "portfolio"},
