    "swap.from_asset":        {"screen": "payments",  "shows": "The asset the user gives up in a swap", "terms": ["swap"], "screen_data": null},
    "swap.to_asset":          {"screen": "payments",  "shows": "The asset the user gets in a swap", "terms": ["swap"], "screen_data": null}
