# The hosted demo's settings (copy to backend/.env and fill in the key). Keys never go in Git.
# Fast engine: prepared answers and the fast path first, then the models below, in order: a slow or failing one
# hands over to the next. Gemini is optional (entries without a key are skipped).
ASSISTANT_ENGINE=legacy
ICARUS_LLM_API_KEY=
LLM_CHAIN=orion:Qwen 3.8-27B,orion:Mango 1.5-9B,gemini:gemini-3.1-flash-lite,gemini:gemini-3-flash-preview
# GEMINI_API_KEY=
LLM_HEDGE_MS=2500
LLM_COOLDOWN_S=60
LLM_TIMEOUT_S=8
ANSWER_CACHE_TTL_S=300
FASTPATH=1

# ---- other setups (local experiments) ----
# Copy this file to backend/.env and fill in what you need.
# backend/.env is ignored by git (see the root .gitignore). Never put a real key in this example file.

# Model branch integration (default engine). Offline preview makes no gateway calls.
# ASSISTANT_ENGINE=model   (Luka's engine instead; slower, see model/)
# ICARUS_MODEL_OFFLINE=1
# To enable gateway reasoning: set ICARUS_MODEL_OFFLINE=0 and fill these in.
# ICARUS_LLM_BASE_URL=https://api.orion.cmkl.ai/v1
# ICARUS_LLM_MODEL=REPLACE_WITH_EXACT_GATEWAY_MODEL_ID
# Or reuse an existing ignored model environment without copying credentials:
# ICARUS_MODEL_ENV_FILE=D:/Uhackathon/model/.env
# Market polling is separate from model reasoning. 1 serves disk observations only (no live prices).
# OFFLINE=1
# Default origins include the voice-hosted frontend on 8787 and dev ports 5173/3000.
# CORS_ORIGINS=http://localhost:8787,http://127.0.0.1:8787

# Legacy assistant only (ASSISTANT_ENGINE=legacy): ollama | groq | gemini
# LLM_PROVIDER=ollama
# LLM_MODEL=icarus

# Only needed if LLM_PROVIDER=groq (free key at console.groq.com)
# GROQ_API_KEY=

# Only needed if LLM_PROVIDER=gemini (free key at aistudio.google.com)

# Who the voice server's "demo-user" is
# DEMO_USER=u_new

