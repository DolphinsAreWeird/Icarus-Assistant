# Copy this file to backend/.env and fill in what you need.
# backend/.env is ignored by git (see the root .gitignore). Never put a real key in this example file.

# Model branch integration (default engine). Offline preview makes no gateway calls.
ASSISTANT_ENGINE=model
ICARUS_MODEL_OFFLINE=1
# To enable gateway reasoning: set ICARUS_MODEL_OFFLINE=0 and fill these in.
# ICARUS_LLM_BASE_URL=https://api.orion.cmkl.ai/v1
# ICARUS_LLM_MODEL=REPLACE_WITH_EXACT_GATEWAY_MODEL_ID
# ICARUS_LLM_API_KEY=
# Market polling is separate from model reasoning. 1 serves disk observations only.
OFFLINE=1
# Default origins include the voice-hosted frontend on 8787 and dev ports 5173/3000.
# CORS_ORIGINS=http://localhost:8787,http://127.0.0.1:8787

# Legacy assistant only (ASSISTANT_ENGINE=legacy): ollama | groq | gemini
LLM_PROVIDER=ollama
# LLM_MODEL=icarus

# Only needed if LLM_PROVIDER=groq (free key at console.groq.com)
GROQ_API_KEY=

# Only needed if LLM_PROVIDER=gemini (free key at aistudio.google.com)
GEMINI_API_KEY=

# Who the voice server's "demo-user" is
# DEMO_USER=u_new

# 1 = no internet calls, serve saved prices only
# OFFLINE=1
