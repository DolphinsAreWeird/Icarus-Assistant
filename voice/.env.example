# Copy this file to .env and fill it in:   cp .env.example .env
# .env is ignored by git. Never commit it, never paste the key into code or chat.

# ---- Required for real voice ----
ELEVENLABS_API_KEY=
# Our voices (picked 15 Oct for the cute theme, see README "Choosing the voices"): English Brittney, Thai Malee.
# Library voices work by ID on a paid ElevenLabs plan. The Thai voice must still be checked by a Thai speaker.
VOICE_ID_EN=XiPS9cXxAVbaIWtGDHDh
VOICE_ID_TH=mYcpTKg1oj1H5CtzUZNO

# ---- Work without a key or credits ----
# 1 = fake tones instead of speech, plus a fake Scribe that "hears" scripted phrases.
# FAKE_ELEVENLABS=1

# ---- Server ----
# PORT=8787
# Who may call the server from a browser. * is fine on your laptop. Use the real origin when deployed.
# ALLOWED_ORIGINS=http://localhost:5173

# ---- Text-to-speech ----
# English: Flash v2.5 is the fastest (about 75 ms) but does NOT support Thai.
# TTS_MODEL_EN=eleven_flash_v2_5
# Thai: v4 Turbo (about 100 ms) supports Thai. The others are tried only if a model is rejected.
# TTS_MODEL_TH=eleven_v4_turbo,eleven_v4,eleven_v3
# The browser plays raw 16-bit PCM, so this must be a pcm_* format.
# TTS_OUTPUT_FORMAT=pcm_24000
# Refuse to speak anything longer than this many characters (protects credits).
# TTS_MAX_CHARS=1000
# A library voice is slow the first time it speaks (2 to 3 s to the first audio, then about 150 ms). So the server
# says one short word in each voice when it starts and again every this many minutes. A few characters each time.
# 0 = off.
# TTS_WARMUP_MINUTES=20

# ---- Speech-to-text (Scribe v2 Realtime) ----
# vad = Scribe ends the turn after a silence. Hands-free uses this. Push to talk always uses manual.
# (turn_prediction is NOT available for scribe_v2_realtime: the live API refuses it.)
# STT_COMMIT_STRATEGY=vad
# Silence before a turn ends. The biggest part of the wait before Icarus answers.
# Measured live: 0.7 gives about 1150 ms to the final transcript, 0.5 and 0.3 both give about 920 ms.
# Lower than 0.5 does not help and may cut people off mid-sentence.
# STT_VAD_SILENCE_SECS=0.5
# STT_VAD_THRESHOLD=0.4
# STT_MIN_SPEECH_MS=100
# STT_MIN_SILENCE_MS=100
# STT_NO_VERBATIM=true

# ---- Assistant ----
# mock = canned replies (default). http = the real assistant, called at ASSISTANT_URL.
# For Luka and First's backend (cd backend && .venv/bin/uvicorn app.main:app --port 8000):
# ASSISTANT_MODE=http
# ASSISTANT_URL=http://localhost:8000/chat
# The backend only knows its demo users. u_new is new to the app, u_small has a small portfolio.
# ASSISTANT_USER_ID=u_new
# ASSISTANT_TIMEOUT_MS=15000
# How long the mock pretends to think.
# MOCK_ASSISTANT_DELAY_MS=120

# ---- Questions about U-topia, and the handoff to U-Bot ----
# mock = the glossary in src/config/utopia-glossary.ts (default). U-Bot has no API yet.
# http = a real endpoint. See HttpUtopiaKnowledge in src/server/utopia/knowledge.ts for the request we propose.
# UTOPIA_MODE=mock
# UTOPIA_URL=
# This key stays on the server. It is never sent to the browser.
# UTOPIA_API_KEY=
# UTOPIA_TIMEOUT_MS=8000
# What the "Open U-Bot" button opens.
#   mock = our U-Bot MOCK, with the user's question carried over and sample options (default; says "mock" on screen)
#   link = the real U-Bot's front door at UBOT_URL. It has no deep link, so the user signs in and pastes the question.
# UBOT_MODE=mock
# UBOT_URL=https://u.bot/
# The mock also serves our proposed "Ask U-topia" API. To exercise the HTTP path end to end:
#   UTOPIA_MODE=http  and  UTOPIA_URL=http://localhost:8787/mock/ubot/ask

# ---- Folders (relative to voice/) ----
# AUDIO_CACHE_DIR=.audio-cache
# DEMO_AUDIO_DIR=demo-audio
# LOG_DIR=logs

# ---- Advanced: point at another ElevenLabs endpoint (for example a regional one) ----
# ELEVENLABS_BASE_URL=
# ELEVENLABS_WS_BASE_URL=
