# Copy this file to .env and fill it in:   cp .env.example .env
# .env is ignored by git. Never commit it, never paste the key into code or chat.

# ---- Required for real voice ----
ELEVENLABS_API_KEY=
# Pick voices in the ElevenLabs voice library. The Thai voice must be checked by a Thai speaker.
VOICE_ID_EN=
VOICE_ID_TH=

# ---- Work without a key or credits ----
# 1 = fake tones instead of speech, plus a fake Scribe that "hears" scripted phrases.
# FAKE_ELEVENLABS=1

# ---- Server ----
# PORT=8787
# Who may call the server from a browser. * is fine on your laptop. Use the real origin when deployed.
# ALLOWED_ORIGINS=http://localhost:5173

# ---- Text-to-speech ----
# English: Flash v2.5 is the fastest (about 75 ms) but does NOT support Thai.
# TTS_MODEL_EN=eleven_flash_v2_5
# Thai: v4 Turbo (about 100 ms) supports Thai. The others are tried only if a model is rejected.
# TTS_MODEL_TH=eleven_v4_turbo,eleven_v4,eleven_v3
# The browser plays raw 16-bit PCM, so this must be a pcm_* format.
# TTS_OUTPUT_FORMAT=pcm_24000
# Refuse to speak anything longer than this many characters (protects credits).
# TTS_MAX_CHARS=1000

# ---- Speech-to-text (Scribe v2 Realtime) ----
# vad = Scribe ends the turn after a silence. Hands-free uses this. Push to talk always uses manual.
# STT_COMMIT_STRATEGY=vad
# Silence before a turn ends. The biggest part of the wait before Icarus answers.
# Lower is faster but may cut people off mid-sentence.
# STT_VAD_SILENCE_SECS=0.7
# STT_VAD_THRESHOLD=0.4
# STT_MIN_SPEECH_MS=100
# STT_MIN_SILENCE_MS=100
# STT_FILTER_BACKGROUND=true
# STT_NO_VERBATIM=true

# ---- Assistant ----
# mock = canned replies (default). http = the real assistant, called at ASSISTANT_URL.
# ASSISTANT_MODE=mock
# ASSISTANT_URL=http://localhost:3000/ask
# ASSISTANT_TIMEOUT_MS=15000
# How long the mock pretends to think.
# MOCK_ASSISTANT_DELAY_MS=120

# ---- Folders (relative to voice/) ----
# AUDIO_CACHE_DIR=.audio-cache
# DEMO_AUDIO_DIR=demo-audio
# LOG_DIR=logs

# ---- Advanced: point at another ElevenLabs endpoint (for example a regional one) ----
# ELEVENLABS_BASE_URL=
# ELEVENLABS_WS_BASE_URL=
